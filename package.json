{
  "name": "pi-web-access",
  "version": "0.23.0",
  "description": "Web search, URL fetching, GitHub repo cloning, PDF extraction, YouTube video understanding, and local video analysis for Pi coding agent. Supports OpenAI, Brave, Parallel, TinyFish, Search1API, Searchinfinity, Querit, Tavily, Firecrawl, Jina, SERPdive, Kagi, Ollama, AnySearch, Bright Data SERP, SerpBase, SearXNG, Exa, Perplexity, and Gemini.",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "test:ci": "node --test test/toml-config-e2e.test.mjs test/config-loading-integration.test.mjs",
    "test:e2e": "node --test test/tool-e2e.test.mjs",
    "typecheck": "tsc",
    "audit:runtime": "npm audit --omit=dev --omit=peer"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "web-search",
    "tinyfish",
    "search1api",
    "searchinfinity",
    "querit",
    "perplexity",
    "fetch",
    "scraping"
  ],
  "author": "Nico Bailon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicobailon/pi-web-access.git"
  },
  "bugs": {
    "url": "https://github.com/nicobailon/pi-web-access/issues"
  },
  "homepage": "https://github.com/nicobailon/pi-web-access#readme",
  "files": [
    "*.ts",
    "config-template.toml",
    "CHANGELOG.md",
    "SECURITY.md",
    "banner.png",
    "pi-web-fetch-demo.mp4"
  ],
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/turndown": "^5.0.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.16.0",
    "p-limit": "^6.1.0",
    "promise.try": "^2.0.1",
    "smol-toml": "^1.8.0",
    "turndown": "^7.2.0",
    "typebox": "^1.1.38",
    "undici": "^8.9.0",
    "unpdf": "^1.6.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "video": "https://github.com/nicobailon/pi-web-access/raw/refs/heads/main/pi-web-fetch-demo.mp4"
  }
}
